# Copy this file to .env and fill in your own key. NEVER commit .env.
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: preferred model. If it is unavailable the server automatically
# falls back to gemini-flash-latest, gemini-2.5-flash, then gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Optional
# PORT=3000
# RATE_LIMIT_MAX=60
